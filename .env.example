# Copy to .env (cp .env.example .env). No real secrets needed for local run.

# --- api ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=0
PRODUCT_SOURCE=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
FAKESTORE_TIMEOUT_MS=5000
CATALOGUE_CACHE_TTL_SECONDS=300
FEATURED_CONFIG_PATH=./config/featured.json

# --- email ---
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Storefront <no-reply@storefront.local>"
SALES_INBOX_EMAIL=sales@storefront.local
ENQUIRY_RATE_LIMIT_MAX=10
ENQUIRY_RATE_LIMIT_WINDOW_MINUTES=15
